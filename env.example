# Copy to .env and fill in. Both are optional but strongly recommended.

# https://nvd.nist.gov/developers/request-an-api-key
# Without a key NVD throttles you to 5 requests / 30s; with one, 50 / 30s.
NVD_API_KEY=

# A classic or fine-grained PAT with public_repo scope. Used only to raise the
# REST rate limit from 60/hr to 5000/hr when resolving repo metadata.
GITHUB_TOKEN=
